{
  "name": "cf-core-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:cfkit": "tsc -p tools/cfkit/tsconfig.json --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cf-core-kit-dev --local",
    "test": "vitest run",
    "test:scripts": "node --test scripts/auth/generate-keys.test.mjs scripts/budget/check.test.mjs scripts/drift/check.test.mjs scripts/contract/check.test.mjs scripts/contract/lint.test.mjs scripts/lint/zones.test.mjs tools/cfkit/cfkit.test.ts",
    "budget:check": "node scripts/budget/check.mjs",
    "drift:check": "node scripts/drift/check.mjs",
    "contract:check": "node scripts/contract/check.mjs",
    "contract:emit": "node scripts/contract/emit.mjs",
    "contract:lint": "node scripts/contract/lint.mjs",
    "cfkit": "node tools/cfkit/cli.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "npm run cfkit -- verify --profile fast",
    "verify:ci": "npm run cfkit -- verify --profile full"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  }
}
