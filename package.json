{
  "name": "cf-core-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:cfkit": "tsc -p tools/cfkit/tsconfig.json --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cf-core-kit-dev --local",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test scripts/auth/generate-keys.test.mjs scripts/budget/check.test.mjs scripts/drift/check.test.mjs scripts/contract/check.test.mjs scripts/contract/lint.test.mjs scripts/lint/zones.test.mjs scripts/ci/workflow.test.mjs scripts/security/secrets-scan.test.mjs scripts/duplication/check.test.mjs scripts/parity/harness.test.mjs tools/cfkit/cfkit.test.ts tools/cfkit/cli-main.test.ts tools/cfkit/failure-taxonomy.test.ts tools/cfkit/process-runner.test.ts tools/cfkit/profiles.test.ts tools/cfkit/scaffold.test.ts tools/cfkit/remove.test.ts tools/cfkit/task.test.ts tools/cfkit/handoff.test.ts tools/cfkit/ci-classify.test.ts tools/cfkit/risk-classifier.test.ts scripts/config/check.test.mjs scripts/smells/check.test.mjs scripts/gates/check.test.mjs scripts/tests/tiers.test.mjs tools/cfkit/oracles.test.ts scripts/mutation/pilot.test.mjs tools/cfkit/plans.test.ts tools/cfkit/episodes.test.ts tools/cfkit/evidence.test.ts tools/cfkit/events.test.ts tools/cfkit/maintenance.test.ts tools/cfkit/workspace.test.ts tools/cfkit/baseline-pruner.test.ts tools/cfkit/scaffold-endpoint.test.ts tools/cfkit/docs.test.ts tools/cfkit/improvements.test.ts scripts/parity/tree.test.mjs",
    "budget:check": "node scripts/budget/check.mjs",
    "drift:check": "node scripts/drift/check.mjs",
    "duplication:check": "node scripts/duplication/check.mjs",
    "secrets:check": "node scripts/security/secrets-scan.mjs",
    "runtime:check": "node tools/cfkit/runtime.ts",
    "scaffold:smoke": "node scripts/scaffold/smoke.mjs",
    "contract:check": "node scripts/contract/check.mjs",
    "contract:emit": "node scripts/contract/emit.mjs",
    "contract:lint": "node scripts/contract/lint.mjs",
    "cfkit": "node tools/cfkit/cli.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "npm run cfkit -- verify --profile fast",
    "verify:ci": "npm run cfkit -- verify --profile ci",
    "harness:parity": "node scripts/parity/harness.mjs",
    "ci:classify": "node tools/cfkit/cli.ts ci classify",
    "config:check": "node scripts/config/check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "smells:check": "node scripts/smells/check.mjs",
    "smells:report": "node scripts/smells/check.mjs --report-only",
    "smells:baseline": "node scripts/smells/check.mjs --write-baseline",
    "duplication:small-helpers": "node scripts/duplication/check.mjs --profile small-helpers",
    "duplication:report": "node scripts/duplication/check.mjs --report",
    "verify:gates": "node scripts/gates/check.mjs",
    "test:unit": "vitest run src test/support",
    "test:int": "vitest run test/integration",
    "test:contract": "vitest run test/contract",
    "oracles:check": "node tools/cfkit/cli.ts oracles check",
    "test:mutation": "node scripts/mutation/pilot.mjs",
    "plans:check": "node tools/cfkit/cli.ts plans check",
    "evidence:check": "node tools/cfkit/cli.ts evidence check",
    "events:run": "node tools/cfkit/cli.ts events run --once",
    "maintenance:run": "node tools/cfkit/cli.ts maintenance run --once",
    "setup:hooks": "git config core.hooksPath .githooks",
    "commitlint": "commitlint --edit",
    "improve:check": "node tools/cfkit/cli.ts improve check",
    "parity:tree": "node scripts/parity/tree.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "description": "Cloudflare Workers core kit: auth and users at wire-contract parity, with a self-verifying harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikrilal/cf-core-kit.git"
  }
}
