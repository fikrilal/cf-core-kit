{
  // Local dev base, mirroring env.dev. Deploys always select an environment:
  // `npm run deploy` (dev) or `wrangler deploy --env staging|prod`, each with
  // its own Worker name, vars, and D1 database (ADR-0010). Database ids are
  // placeholders until `wrangler d1 create` runs against a real account and
  // the returned ids are pasted here — see the README deploy section.
  // Auth rate limiting uses the memory-first AuthRateLimiter Durable Object
  // (ADR-0012); bindings are re-declared per environment on purpose.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-core-kit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "dev",
    "LOG_LEVEL": "info",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "R2_BUCKET": "cf-core-kit-dev",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthRateLimiter"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-core-kit-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "cf-core-kit-jobs-dev",
      },
    ],
    "consumers": [
      {
        "queue": "cf-core-kit-jobs-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "cf-core-kit-dlq-dev",
      },
      {
        "queue": "cf-core-kit-dlq-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "env": {
    "dev": {
      "name": "cf-core-kit-dev",
      "vars": {
        "APP_ENV": "dev",
        "LOG_LEVEL": "info",
        "R2_ACCOUNT_ID": "64cebf25319fc1d66d9a3f2ae510658e",
        "R2_BUCKET": "cf-core-kit-dev",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-dev",
          "database_id": "a59bcaa8-9cc4-4926-a9a7-b86a33c13a00",
          "migrations_dir": "db/migrations",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "cf-core-kit-jobs-dev",
          },
        ],
        "consumers": [
          {
            "queue": "cf-core-kit-jobs-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 30,
            "dead_letter_queue": "cf-core-kit-dlq-dev",
          },
          {
            "queue": "cf-core-kit-dlq-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
    "staging": {
      "name": "cf-core-kit-staging",
      "vars": {
        "APP_ENV": "staging",
        "LOG_LEVEL": "info",
        "R2_ACCOUNT_ID": "00000000000000000000000000000000",
        "R2_BUCKET": "cf-core-kit-staging",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "cf-core-kit-jobs-staging",
          },
        ],
        "consumers": [
          {
            "queue": "cf-core-kit-jobs-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 30,
            "dead_letter_queue": "cf-core-kit-dlq-staging",
          },
          {
            "queue": "cf-core-kit-dlq-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
    "prod": {
      "name": "cf-core-kit-prod",
      "vars": {
        "APP_ENV": "prod",
        "LOG_LEVEL": "info",
        "R2_ACCOUNT_ID": "00000000000000000000000000000000",
        "R2_BUCKET": "cf-core-kit-prod",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "cf-core-kit-jobs-prod",
          },
        ],
        "consumers": [
          {
            "queue": "cf-core-kit-jobs-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 30,
            "dead_letter_queue": "cf-core-kit-dlq-prod",
          },
          {
            "queue": "cf-core-kit-dlq-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
}
