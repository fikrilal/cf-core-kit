{
  // Local dev base, mirroring env.dev. Deploys always select an environment:
  // `npm run deploy` (dev) or `wrangler deploy --env staging|prod`, each with
  // its own Worker name, vars, and D1 database (ADR-0010). Database ids are
  // placeholders until `wrangler d1 create` runs against a real account and
  // the returned ids are pasted here — see the README deploy section.
  // Auth rate limiting uses the memory-first AuthRateLimiter Durable Object
  // (ADR-0012); bindings are re-declared per environment on purpose.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-core-kit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "dev",
    "LOG_LEVEL": "info",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthRateLimiter"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-core-kit-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
    },
  ],
  "env": {
    "dev": {
      "name": "cf-core-kit-dev",
      "vars": {
        "APP_ENV": "dev",
        "LOG_LEVEL": "info",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
        },
      ],
    },
    "staging": {
      "name": "cf-core-kit-staging",
      "vars": {
        "APP_ENV": "staging",
        "LOG_LEVEL": "info",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
        },
      ],
    },
    "prod": {
      "name": "cf-core-kit-prod",
      "vars": {
        "APP_ENV": "prod",
        "LOG_LEVEL": "info",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AUTH_RATE_LIMITER",
            "class_name": "AuthRateLimiter",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AuthRateLimiter"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cf-core-kit-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
        },
      ],
    },
  },
}
