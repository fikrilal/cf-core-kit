{
  // Environments (dev / staging / prod) and bindings land with the
  // deployment and platform-core phases — see ADR-0010.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-core-kit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "dev",
    "LOG_LEVEL": "info",
  },
  "d1_databases": [
    {
      // Local/dev placeholder id (zero UUID); the real id is set in the
      // deployment phase — see ADR-0010.
      "binding": "DB",
      "database_name": "cf-core-kit",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
    },
  ],
}
